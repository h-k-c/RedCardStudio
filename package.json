{
  "name": "redcard-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "redcard-mcp": "./mcp/server.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:mcp": "vue-tsc --noEmit && vite build && tsx mcp/build.ts",
